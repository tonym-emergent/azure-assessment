{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "16045612440267695014"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Deployment environment name used by azd and for resource naming."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "assessmentTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional override for the Entra tenant ID exposed to the application. When empty, the current deployment tenant is used."
      }
    },
    "assessmentDefaultSubscriptionIds": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Default subscription IDs the assessment API should inspect when a request does not provide an explicit scope."
      }
    },
    "assessmentQueueName": {
      "type": "string",
      "defaultValue": "assessment-jobs",
      "metadata": {
        "description": "Queue used for asynchronous assessment jobs."
      }
    },
    "assessmentTableName": {
      "type": "string",
      "defaultValue": "assessmentjobs",
      "metadata": {
        "description": "Table used to persist assessment job metadata and status."
      }
    },
    "assessmentResultsContainer": {
      "type": "string",
      "defaultValue": "assessment-results",
      "metadata": {
        "description": "Blob container used for generated result artifacts."
      }
    },
    "assessmentConfigContainer": {
      "type": "string",
      "defaultValue": "assessment-config",
      "metadata": {
        "description": "Blob container used for configuration documents."
      }
    },
    "assessmentReferenceContainer": {
      "type": "string",
      "defaultValue": "assessment-reference",
      "metadata": {
        "description": "Blob container used for static reference assets."
      }
    },
    "deploymentPackageContainer": {
      "type": "string",
      "defaultValue": "deployments",
      "metadata": {
        "description": "Blob container used by the Flex Consumption deployment package."
      }
    },
    "assessmentScriptPath": {
      "type": "string",
      "defaultValue": "assets\\azure-vm-analysis\\azure-vm-assessment.ps1",
      "metadata": {
        "description": "PowerShell assessment script path inside the deployed Functions package."
      }
    },
    "assessmentDefaultConfigPath": {
      "type": "string",
      "defaultValue": "assets\\azure-vm-analysis\\azure-vm-assessment.config.jsonc",
      "metadata": {
        "description": "Default assessment config path inside the deployed Functions package."
      }
    },
    "assessmentOutputPrefix": {
      "type": "string",
      "defaultValue": "vm-analysis-api",
      "metadata": {
        "description": "Default output prefix used by the PowerShell assessment runner."
      }
    },
    "functionRuntime": {
      "type": "string",
      "defaultValue": "node",
      "allowedValues": [
        "node",
        "powerShell"
      ],
      "metadata": {
        "description": "Functions runtime name for the Flex Consumption app."
      }
    },
    "functionRuntimeVersion": {
      "type": "string",
      "defaultValue": "20",
      "metadata": {
        "description": "Functions runtime version for the selected language runtime."
      }
    },
    "maximumInstanceCount": {
      "type": "int",
      "defaultValue": 100,
      "minValue": 40,
      "maxValue": 1000,
      "metadata": {
        "description": "Maximum number of Flex Consumption instances."
      }
    },
    "instanceMemoryMB": {
      "type": "int",
      "defaultValue": 2048,
      "allowedValues": [
        2048,
        4096
      ],
      "metadata": {
        "description": "Memory size in MB for each Flex Consumption instance."
      }
    },
    "zoneRedundant": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable zone redundancy on the Flex Consumption plan when the selected region supports it."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags applied to deployed Azure resources."
      }
    }
  },
  "variables": {
    "uniqueToken": "[toLower(uniqueString(subscription().subscriptionId, resourceGroup().id, parameters('environmentName')))]",
    "storageAccountName": "[take(format('st{0}', variables('uniqueToken')), 24)]",
    "functionAppName": "[take(format('func-{0}-{1}', parameters('environmentName'), variables('uniqueToken')), 60)]",
    "hostingPlanName": "[take(format('plan-{0}-{1}', parameters('environmentName'), variables('uniqueToken')), 40)]",
    "logAnalyticsWorkspaceName": "[take(format('log-{0}-{1}', parameters('environmentName'), variables('uniqueToken')), 63)]",
    "applicationInsightsName": "[take(format('appi-{0}-{1}', parameters('environmentName'), variables('uniqueToken')), 260)]",
    "effectiveTenantId": "[if(empty(parameters('assessmentTenantId')), tenant().tenantId, parameters('assessmentTenantId'))]",
    "effectiveTags": "[union(parameters('tags'), createObject('azd-env-name', parameters('environmentName'), 'azd-service-name', 'api', 'Workload', 'azure-assessment'))]",
    "storageBlobDataOwnerRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b7e6dc6d-f1e8-4753-8033-0f276bb0955b')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('deploymentPackageContainer'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('assessmentResultsContainer'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('assessmentConfigContainer'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('assessmentReferenceContainer'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices/queues",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('assessmentQueueName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/queueServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', parameters('assessmentTableName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/tableServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/queueServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('effectiveTags')]",
      "properties": {
        "retentionInDays": 30,
        "features": {
          "searchVersion": 1
        },
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('applicationInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('effectiveTags')]",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
        "DisableLocalAuth": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('effectiveTags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": true,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "tags": "[variables('effectiveTags')]",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "properties": {
        "reserved": true,
        "zoneRedundant": "[parameters('zoneRedundant')]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[variables('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "tags": "[variables('effectiveTags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "minTlsVersion": "1.2"
        },
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[format('{0}{1}', reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01').primaryEndpoints.blob, parameters('deploymentPackageContainer'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "runtime": {
            "name": "[parameters('functionRuntime')]",
            "version": "[parameters('functionRuntimeVersion')]"
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": "[parameters('maximumInstanceCount')]",
            "instanceMemoryMB": "[parameters('instanceMemoryMB')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/appsettings', variables('functionAppName'))]",
      "properties": {
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('applicationInsightsName')), '2020-02-02').ConnectionString]",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', variables('applicationInsightsName')), '2020-02-02').InstrumentationKey]",
        "AzureWebJobsStorage": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', variables('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01').keys[0].value, environment().suffixes.storage)]",
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "[parameters('functionRuntime')]",
        "WEBSITE_NODE_DEFAULT_VERSION": "[format('~{0}', parameters('functionRuntimeVersion'))]",
        "ASSESSMENT_TENANT_ID": "[variables('effectiveTenantId')]",
        "ASSESSMENT_LOCATION": "[parameters('location')]",
        "ASSESSMENT_DEFAULT_SUBSCRIPTION_IDS": "[join(parameters('assessmentDefaultSubscriptionIds'), ',')]",
        "ASSESSMENT_STORAGE_SUBSCRIPTION_ID": "[subscription().subscriptionId]",
        "ASSESSMENT_STORAGE_RESOURCE_GROUP": "[resourceGroup().name]",
        "ASSESSMENT_STORAGE_ACCOUNT_NAME": "[variables('storageAccountName')]",
        "ASSESSMENT_QUEUE_NAME": "[parameters('assessmentQueueName')]",
        "ASSESSMENT_TABLE_NAME": "[parameters('assessmentTableName')]",
        "ASSESSMENT_RESULTS_CONTAINER": "[parameters('assessmentResultsContainer')]",
        "ASSESSMENT_CONFIG_CONTAINER": "[parameters('assessmentConfigContainer')]",
        "ASSESSMENT_REFERENCE_CONTAINER": "[parameters('assessmentReferenceContainer')]",
        "ASSESSMENT_SCRIPT_PATH": "[parameters('assessmentScriptPath')]",
        "ASSESSMENT_DEFAULT_CONFIG_PATH": "[parameters('assessmentDefaultConfigPath')]",
        "ASSESSMENT_OUTPUT_PREFIX": "[parameters('assessmentOutputPrefix')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('applicationInsightsName'))]",
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', variables('functionAppName')), 'storage-blob-data-owner')]",
      "properties": {
        "roleDefinitionId": "[variables('storageBlobDataOwnerRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "functionAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]"
    },
    "functionEndpoint": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2024-04-01').defaultHostName)]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[variables('logAnalyticsWorkspaceName')]"
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[variables('applicationInsightsName')]"
    },
    "resultsContainerName": {
      "type": "string",
      "value": "[parameters('assessmentResultsContainer')]"
    },
    "configContainerName": {
      "type": "string",
      "value": "[parameters('assessmentConfigContainer')]"
    },
    "referenceContainerName": {
      "type": "string",
      "value": "[parameters('assessmentReferenceContainer')]"
    }
  }
}
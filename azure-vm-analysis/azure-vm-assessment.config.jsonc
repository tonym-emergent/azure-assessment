{
  // How many days of Azure Monitor history to inspect.
  // Larger windows may automatically use coarser metric intervals.
  "DaysToInspect": 14,

  // One or more subscription IDs to assess.
  // Leave empty to use the current Azure CLI subscription context.
  "SubscriptionId": [],

  // Prefix used in generated output file names before the timestamp.
  "OutputPrefix": "vm-analysis",

  // Optional VM name filter.
  // Leave empty to assess all VMs in the selected subscriptions.
  "VMName": [],

  // If true, forces Advisor recommendations to refresh during the run.
  // This can make collection slower but may return newer recommendations.
  "RefreshAdvisor": false,

  // Underutilized classification settings.
  // A VM is a better downsizing candidate when CPU and throughput stay below these values.
  "UnderutilizedCpuAverageThreshold": 10,
  "UnderutilizedCpuP95Threshold": 25,

  // Overutilized classification settings.
  // A VM is more likely to be under pressure when CPU exceeds these thresholds.
  "OverutilizedCpuAverageThreshold": 65,
  "OverutilizedCpuP95Threshold": 85,

  // Host-level MB/s thresholds used during underutilization checks.
  // Low sustained network and disk throughput support a rightsizing recommendation.
  "LowNetworkAverageThresholdMBps": 0.5,
  "LowDiskAverageThresholdMBps": 1.0,

  // B-series specific threshold.
  // If average remaining CPU credits drop below this value while CPU stays busy,
  // the VM can be flagged as needing burstable attention.
  "BurstableLowCreditsThreshold": 20,

  // Minimum count of CPU samples required before the script will classify utilization.
  // Below this value the VM is marked as Insufficient Data.
  "MinimumSamplesForClassification": 12,

  "Report": {
    // Output directory for JSON, CSV, and HTML files.
    // Relative paths are resolved from the script folder.
    "OutputDirectory": ".",

    // Toggle individual output formats.
    // At least one of these must remain true.
    "GenerateJson": true,
    "GenerateCsv": true,
    "GenerateHtml": true,

    // Browser-facing report text.
    // These values only affect the generated HTML report.
    "DocumentTitle": "Azure VM Assessment Report",
    "HeroEyebrow": "Azure Virtual Machine Assessment",
    "HeroTitle": "Advisor, utilization, and compute commitment analysis in one view.",
    "HeroDescription": "This report combines Azure Advisor Cost and Performance guidance with Azure Monitor host metrics and retail VM pricing. Cost comparisons use the recommended target SKU when one is available, and Windows pricing includes OS license only when the VM is not using a license benefit.",
    "GeneratedLabel": "Generated from the local assessment script.",

    // Optional override for the scope sentence shown in the report header.
    // Leave blank to let the script generate the default scope text automatically.
    "ScopeTextOverride": "",

    // Informational text shown beneath the report table.
    "FooterNote": "Pricing reflects compute with OS license when applicable for the matched Azure VM retail meter. Windows OS license is excluded when the VM license state indicates a benefit such as Azure Hybrid Benefit. Attached disks, savings plans, and guest memory were not included in this version.",

    // Prefix used when a user exports visible rows from the HTML report.
    "VisibleRowsExportPrefix": "vm-assessment-visible"
  }
}